# Copy to backend/.env and fill in. Every value below has a working default,
# so an unedited copy runs fine for local development.

# ── Database ────────────────────────────────────────────────────────────────
# Leave as-is to run without MongoDB (in-memory fallback), or paste an Atlas URI.
MONGO_URI=mongodb://localhost:27017
DB_NAME=finalyearproject
MONGO_DB=finalyearproject

# ── Auth ────────────────────────────────────────────────────────────────────
# true  = accept any request as a demo user (no Firebase service account needed)
# false = verify real Firebase ID tokens; requires backend/firebase-adminsdk.json
AUTH_ALLOW_MOCK=true
FIREBASE_CREDENTIALS_PATH=backend/firebase-adminsdk.json

# Emails promoted to the admin role on login (comma separated).
ADMIN_EMAILS=

# ── Model ───────────────────────────────────────────────────────────────────
MODEL_PATH=ml-service/models/breed_model.pt
CLASS_INDEX_PATH=ml-service/models/class_names.json
MODEL_META_PATH=ml-service/models/model_meta.json

# ── Chatbot (optional) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Tuning ──────────────────────────────────────────────────────────────────
BLUR_THRESHOLD=100.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
