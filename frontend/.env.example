# Copy to frontend/.env and fill in with your own Firebase project values.
# Console -> Project settings -> General -> Your apps -> SDK setup and config.
# These are public by design; access is controlled by Firebase security rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional - only needed if you want Firebase Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# Where the FastAPI backend is listening.
VITE_API_BASE_URL=http://localhost:8000
